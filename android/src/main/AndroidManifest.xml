<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online play: signaling over WebSocket, the game over WebRTC. Same Wi-Fi: the hub's WebSocket on the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Same Wi-Fi: hearing hosts' broadcasts takes the Wi-Fi multicast lock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:label="Orbitrix"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- The game lays itself out again on every size change, so rotating, folding or resizing must not restart it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
