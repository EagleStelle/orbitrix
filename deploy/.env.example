# Copy to deploy/.env and fill in; .env is never committed.

# The site's public address. Browsers may open /signal only from it.
PUBLIC_ORIGIN=https://orbitrix.example.com

# Empty: anyone can host online games, without a password, using STUN only. Set one (random, at least 20 characters,
# from a password manager) to make hosts enter it and, with the TURN key below, to use TURN. Change it and restart the
# container to rotate it.
HOST_PASSWORD=

# Cloudflare Realtime TURN key (Dashboard → Realtime → TURN). TURN needs both of these and a HOST_PASSWORD of at least
# 20 characters; otherwise, or whenever Cloudflare fails, the server falls back to STUN: no cost, but some CGNAT pairs
# can't connect.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
